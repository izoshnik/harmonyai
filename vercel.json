{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/harmony",
      "destination": "/api/chat"
    },
    {
      "source": "/api/intent",
      "destination": "/api/util?op=intent"
    },
    {
      "source": "/api/music-intent",
      "destination": "/api/util?op=music-intent"
    },
    {
      "source": "/api/title",
      "destination": "/api/util?op=title"
    },
    {
      "source": "/api/detect-locale",
      "destination": "/api/util?op=detect-locale"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api-dashboard.html"
    },
    {
      "source": "/api",
      "destination": "/api-docs.html"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/v1?path=$1"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contacts",
      "destination": "/contacts.html"
    },
    {
      "source": "/subscribe",
      "destination": "/subscribe.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/chat",
      "destination": "/app.html"
    },
    {
      "source": "/chat/:id",
      "destination": "/app.html"
    },
    {
      "source": "/settings",
      "destination": "/app.html"
    },
    {
      "source": "/management",
      "destination": "/management.html"
    },
    {
      "source": "/legal/ofera",
      "destination": "/legal/ofera.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Powered-By",
          "value": ""
        },
        {
          "key": "Server",
          "value": ""
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), payment=(self), microphone=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://esm.sh https://cdn.jsdelivr.net https://unpkg.com https://cdn.skypack.dev https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://harmonyai.ru https://api.harmonyai.ru https://harmonyai-zeta.vercel.app https://api.codex-api.online https://esm.sh https://cdn.jsdelivr.net https://unpkg.com https://api.audd.io https://*.supabase.co https://api.acoustid.org https://musicbrainz.org wss://*.supabase.co https://api.yookassa.ru http://ip-api.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://yookassa.ru; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/i18n.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/i18_dict.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
