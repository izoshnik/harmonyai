; Engine configuration file.
config_version=5

[application]
config/name="Приморский 2026"
config/description="Открытый мир: реальный Приморский район Санкт-Петербурга (данные OpenStreetMap, 07.10.2026)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/vsync/vsync_mode=1

[autoload]

Settings="*res://scripts/settings.gd"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=4
global_illumination/sdfgi/probe_ray_count=1

[shader_globals]

night={
"type": "float",
"value": 0.0
}
