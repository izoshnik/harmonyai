# HarmonyAI — переменные окружения (Vercel)
# Скопируйте нужные значения в Vercel → Settings → Environment Variables.
# Этот файл — только образец; реальные ключи сюда не вписывать и не коммитить.

# === ИИ-провайдер чата (Codex API, OpenAI-совместимый) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.codex-api.online/v1

# === Модели чата (Adanatos = free, Dynatos = pro) ===
# Реальные имена моделей за брендами можно поменять здесь без правки кода.
# Значения по умолчанию заданы в lib/models.js — эти переменные можно вообще
# не создавать на Vercel. Модели семейства 5.4 продуктом не используются:
# lib/models.js отбрасывает такое значение и берёт дефолт (см. isForbiddenModel).
ADANATOS_MODEL=claude-haiku-4-5-20251001
ADANATOS_FALLBACK=claude-haiku-4-5-20251001
DYNATOS_MODEL=gpt-5.5
DYNATOS_FALLBACK=gpt-5.5

# === Служебные модели-классификаторы (дешёвые и быстрые) ===
# INTENT_MODEL           — надо ли генерировать картинку (/api/intent).
# MUSIC_INTENT_MODEL     — надо ли искать и показывать трек (/api/music-intent).
# TITLE_MODEL            — название чата (/api/title).
# IMAGE_MODERATOR_MODEL  — модерация промпта картинки (/api/generate-image).
#   Если пусто — берётся INTENT_MODEL, затем служебная модель из lib/models.js.
#   Без OPENAI_API_KEY классификатор молча отключается, а музыка
#   продолжает работать на быстрых локальных правилах.
INTENT_MODEL=claude-haiku-4-5-20251001
MUSIC_INTENT_MODEL=claude-haiku-4-5-20251001
TITLE_MODEL=claude-haiku-4-5-20251001
IMAGE_MODERATOR_MODEL=claude-haiku-4-5-20251001

# === Распознавание музыки / нотный диктант (Pro) ===
# AUDD_API_KEY — точное совпадение записи (audd.io). Без ключа работает
# только эвристика на текстовой модели Pro.
AUDD_API_KEY=
RECOGNIZE_MODEL=gpt-5.5

# === Supabase (база, авторизация, Storage) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Для генерации изображений нужно создать public bucket "generated-images"
# в Supabase → Storage → New bucket (Public = on).

# === Зарезервировано (не используется в текущей маршрутизации) ===
GEMINI_API_KEY=

# === ЮKassa (платежи) ===
YOOKASSA_SHOP_ID=1411296
YOOKASSA_SECRET_KEY=
# URL сайта — используется как return_url после оплаты
SITE_URL=https://harmonyai-zeta.vercel.app


# Account ID: Cloudflare dashboard → справа внизу на любой странице.
# API Token: My Profile → API Tokens → Create Token → Permissions:
#   Account → Workers AI → Edit.
# Это путь генерации картинок для БЕСПЛАТНЫХ пользователей (Adanatos).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# === Генерация картинок для Pro (Dynatos) — gpt-image-2 ===
# По умолчанию идёт через тот же шлюз, что и чат (OPENAI_BASE_URL) и тем же
# ключом (OPENAI_API_KEY). Заполняйте, только если картинки живут отдельно.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=

# === Яндекс.Музыка ===
# Главный рубильник. Пока false — /api/music отвечает 503,
# фронтенд молча работает как раньше. Включайте после настройки.
YANDEX_MUSIC_ENABLED=false

# Общий токен — запасной вариант для тех, кто не подключил свой аккаунт.
# Нужен аккаунт с Плюсом. Можно оставить пустым — тогда каждый
# пользователь подключает себя сам через код в чате.
YANDEX_MUSIC_TOKEN=

# Ключ шифрования пользовательских токенов в базе (AES-256-GCM).
# Любая длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Без этого ключа личные подключения не сохраняются.
# МЕНЯТЬ НЕЛЬЗЯ: старые записи станут нечитаемы.
MUSIC_ENCRYPTION_KEY=

# OAuth-приложение для входа по коду устройства.
# Можно не заполнять — в коде уже есть рабочие значения по умолчанию.
# Заполняйте, если заведёте своё приложение на oauth.yandex.ru.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Соль для подписи ссылок на аудио. Менять только если Яндекс
# сменит алгоритм и воспроизведение перестанет работать.
YANDEX_SIGN_SALT=
